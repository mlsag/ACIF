# Copie para .env e ajuste se precisar. O .env nunca é commitado.
# Valores apenas para desenvolvimento local; sem segredos reais aqui.
# O docker-compose.yml tem estes mesmos padrões, então o .env é opcional.

# PostgreSQL
POSTGRES_USER=acif
POSTGRES_PASSWORD=acif_dev
POSTGRES_DB=acif

# Portas publicadas no host (sempre em 127.0.0.1)
DB_HOST_PORT=5432
API_HOST_PORT=3333
WEB_HOST_PORT=5173

# Auth da API (T06)
# Vazio = segredo só de desenvolvimento. Em produção é obrigatório, com ao menos 32 caracteres.
# Gere um com: openssl rand -hex 32. Nunca coloque um segredo real aqui: o .env.example vai para o Git.
JWT_SECRET=
# Duração da sessão (JWT e cookie), em horas
SESSAO_HORAS=8
# Cookie com Secure: false no ambiente local (http); true quando houver https
COOKIE_SECURE=false
# Tentativas de login por minuto, por IP
LOGIN_RATE_LIMIT_MAX=10
# Cadastros públicos de docente por hora, por IP (T07)
CADASTRO_RATE_LIMIT_MAX=5

# Worker
WORKER_INTERVALO_MS=5000

# Migration e seed (serviço migrate). O seed cria só dados sintéticos (ADR 0009).
SEED_AUTO=true
# Admin do seed. Vazios = admin@example.com e a senha de desenvolvimento definida no seed.
# Nunca coloque aqui uma senha real: o .env.example vai para o Git.
SEED_ADMIN_EMAIL=
SEED_ADMIN_SENHA=
# uid/gid do host para o serviço migrate (o cliente Prisma gerado não fica com dono root)
ACIF_UID=1000
ACIF_GID=1000

# Testes de integração (banco acif_test, criado por docker/db-init na criação do volume)
TEST_DATABASE_URL=postgresql://acif:acif_dev@db:5432/acif_test
